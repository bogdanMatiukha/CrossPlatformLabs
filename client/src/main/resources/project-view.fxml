<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tooltip?>

<VBox spacing="14"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.controller.MainController"
      stylesheets="@styles.css"
      styleClass="root-container">

    <padding>
        <Insets top="14" right="16" bottom="12" left="16"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Система видачі та повернення університетського майна"
               styleClass="title-label"
               HBox.hgrow="ALWAYS"/>

        <Button fx:id="togglePanelButton"
                onAction="#handleTogglePanel"
                styleClass="icon-button">
            <graphic>
                <Label text="⌕" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            </graphic>
            <tooltip>
                <Tooltip text="Пошук і фільтри"/>
            </tooltip>
        </Button>
    </HBox>

    <TabPane fx:id="mainTabPane"
             VBox.vgrow="ALWAYS"
             tabClosingPolicy="UNAVAILABLE">

        <Tab fx:id="requestTab" text="Заявки на видачу">
            <TableView fx:id="requestTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="reqIdCol" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="reqUserCol" text="ID Користувача" prefWidth="110"/>
                    <TableColumn fx:id="reqPropCol" text="ID Майна" prefWidth="90"/>
                    <TableColumn fx:id="reqStatusCol" text="Статус (ЛЦ)" prefWidth="140"/>
                    <TableColumn fx:id="reqIndexCol" text="Інтегр. індекс" prefWidth="110"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </Tab>

        <Tab fx:id="userTab" text="Користувачі">
            <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="userIdCol" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="userFullNameCol" text="ПІБ Користувача" prefWidth="250"/>
                    <TableColumn fx:id="userRoleCol" text="Роль" prefWidth="150"/>
                    <TableColumn fx:id="userEmailCol" text="Email" prefWidth="200"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </Tab>

        <Tab fx:id="propertyTab" text="Інвентар майна">
            <TableView fx:id="propertyTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="propIdCol" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="propInvCol" text="Інв. номер" prefWidth="130"/>
                    <TableColumn fx:id="propNameCol" text="Назва" prefWidth="200"/>
                    <TableColumn fx:id="propCatCol" text="Категорія" prefWidth="150"/>
                    <TableColumn fx:id="propStatusCol" text="Статус майна" prefWidth="130"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </Tab>

        <Tab fx:id="transferTab" text="Журнал передач">
            <TableView fx:id="transferTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="transIdCol" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="transReqCol" text="ID Заявки" prefWidth="90"/>
                    <TableColumn fx:id="transDateCol" text="Дата передачі" prefWidth="130"/>
                    <TableColumn fx:id="transReturnCol" text="Дата повернення" prefWidth="130"/>
                    <TableColumn fx:id="transNotesCol" text="Примітки" prefWidth="220"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </Tab>

    </TabPane>

    <!-- Панель пошуку -->
    <VBox fx:id="searchPanel"
          spacing="8"
          visible="false"
          managed="false"
          styleClass="form-box">

        <HBox spacing="8" alignment="CENTER_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Пошук"/>
                <TextField fx:id="searchField"
                           promptText="Пошук за всіма полями..."/>
            </VBox>

            <VBox spacing="4">
                <Label text="Поле для фільтра"/>
                <ComboBox fx:id="filterFieldCombo"
                          promptText="Виберіть поле"
                          prefWidth="190"
                          minWidth="150"/>
            </VBox>

            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Значення фільтра"/>
                <TextField fx:id="filterValueField"
                           promptText="Введіть значення"/>
            </VBox>

            <Button text="Скинути"
                    onAction="#handleResetFilters"
                    styleClass="secondary-button"/>
        </HBox>

        <Label text="Пошук працює за всіма полями. Фільтр обмежує результати вибраним полем."
               styleClass="search-hint"/>
    </VBox>

    <Label text="Керування записами"
           styleClass="section-label"/>

    <!-- Форма управління записами -->
    <VBox fx:id="formContainer" spacing="10" styleClass="form-box">

        <!-- Користувачі -->
        <HBox fx:id="userFormBox" spacing="8">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="ПІБ користувача"/>
                <TextField fx:id="userFullNameField"
                           promptText="Введіть ПІБ"/>
            </VBox>

            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Роль"/>
                <TextField fx:id="userRoleField"
                           promptText="Наприклад, Студент"/>
            </VBox>

            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Email"/>
                <TextField fx:id="userEmailField"
                           promptText="Введіть email"/>
            </VBox>
        </HBox>

        <!-- Майно -->
        <HBox fx:id="propertyFormBox"
              spacing="8"
              managed="false"
              visible="false">

            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Інвентарний номер"/>
                <TextField fx:id="propInvField"
                           promptText="Наприклад, INV-001"/>
            </VBox>

            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Назва майна"/>
                <TextField fx:id="propNameField"
                           promptText="Введіть назву"/>
            </VBox>

            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Категорія"/>
                <TextField fx:id="propCatField"
                           promptText="Введіть категорію"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Статус майна"/>
                <ComboBox fx:id="propStatusCombo"
                          promptText="Виберіть статус"
                          prefWidth="180"
                          minWidth="150"
                          maxWidth="180"/>
            </VBox>
        </HBox>

        <!-- Заявки -->
        <VBox fx:id="requestFormBox"
              spacing="10"
              managed="false"
              visible="false">

            <HBox spacing="8">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="ID користувача"/>
                    <TextField fx:id="reqUserIdField"
                               promptText="Введіть ID користувача"/>
                </VBox>

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="ID майна"/>
                    <TextField fx:id="reqPropIdField"
                               promptText="Введіть ID майна"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Статус заявки"/>
                    <ComboBox fx:id="reqStatusCombo"
                              promptText="Виберіть статус"
                              minWidth="275"
                              maxWidth="800"/>
                </VBox>
            </HBox>

            <HBox spacing="8">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="F1 — Терміновість"/>
                    <TextField fx:id="reqF1Field"
                               promptText="Від 0 до 100"/>
                </VBox>

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="F2 — Критичність"/>
                    <TextField fx:id="reqF2Field"
                               promptText="Від 0 до 100"/>
                </VBox>

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="F3 — Дефіцит"/>
                    <TextField fx:id="reqF3Field"
                               promptText="Від 0 до 100"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Передачі -->
        <HBox fx:id="transferFormBox"
              spacing="8"
              managed="false"
              visible="false">

            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="ID заявки"/>
                <TextField fx:id="transReqIdField"
                           promptText="Введіть ID заявки"/>
            </VBox>

            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Дата передачі"/>
                <DatePicker fx:id="transDatePicker"
                            promptText="Виберіть дату"
                            maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Дата повернення"/>
                <DatePicker fx:id="transReturnDatePicker"
                            promptText="Виберіть дату"
                            maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Примітки"/>
                <TextField fx:id="transNotesField"
                           promptText="Введіть примітки"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Кнопки управління -->
    <HBox spacing="10">
        <Button text="Додати"
                onAction="#handleAdd"
                styleClass="primary-button"/>

        <Button fx:id="updateButton"
                text="Редагувати"
                onAction="#handleUpdate"
                styleClass="warning-button"/>

        <Button fx:id="deleteButton"
                text="Видалити"
                onAction="#handleDelete"
                styleClass="danger-button"/>

        <Button fx:id="importCsvButton"
                text="Імпорт CSV"
                onAction="#handleImportCsv"
                styleClass="primary-button"/>

        <Button text="Очистити форму"
                onAction="#clearForm"
                styleClass="secondary-button"/>

        <Button text="Оновити список"
                onAction="#handleRefresh"
                styleClass="primary-button"/>
    </HBox>

    <VBox spacing="5">
        <ProgressBar fx:id="requestProgressBar"
                     progress="0"
                     maxWidth="Infinity"
                     prefWidth="1000"
                     prefHeight="18"
                     minHeight="18"
                     visible="false"
                     managed="false"
                     styleClass="request-progress"/>

        <Label fx:id="statusLabel"
               text="Готово"
               maxWidth="Infinity"
               styleClass="status-label"/>
    </VBox>

</VBox>