<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.controller.MainController"
      stylesheets="@styles.css">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Система обліку проєктів"
           styleClass="title-label"/>

    <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn"
                         text="ID"
                         prefWidth="65"/>

            <TableColumn fx:id="nameColumn"
                         text="Назва проєкту"
                         prefWidth="250"/>

            <TableColumn fx:id="managerColumn"
                         text="Керівник"
                         prefWidth="220"/>

            <TableColumn fx:id="durationColumn"
                         text="Тривалість (днів)"
                         prefWidth="150"/>
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Label text="Дані проєкту"
           styleClass="section-label"/>

    <HBox spacing="10">
        <TextField fx:id="nameField"
                   promptText="Назва проєкту"
                   HBox.hgrow="ALWAYS"/>

        <TextField fx:id="managerField"
                   promptText="Керівник"
                   HBox.hgrow="ALWAYS"/>

        <TextField fx:id="durationField"
                   promptText="Тривалість (днів)"
                   HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox spacing="8">
        <Button text="Додати"
                onAction="#handleAdd"
                styleClass="primary-button"/>

        <Button text="Редагувати"
                onAction="#handleUpdate"/>

        <Button text="Видалити"
                onAction="#handleDelete"
                styleClass="danger-button"/>

        <Button text="Оновити список"
                onAction="#handleRefresh"/>
    </HBox>

    <Label text="Фільтрація та пошук"
           styleClass="section-label"/>

    <HBox spacing="10">
        <ComboBox fx:id="fieldComboBox"
                  promptText="Поле"
                  prefWidth="160"/>

        <TextField fx:id="filterField"
                   promptText="Значення для пошуку"
                   HBox.hgrow="ALWAYS"/>

        <Button text="Фільтр"
                onAction="#filterExact"/>

        <Button text="Пошук"
                onAction="#filterLike"
                styleClass="primary-button"/>

        <Button text="Скинути"
                onAction="#resetFilter"/>
    </HBox>

    <Label fx:id="statusLabel"
           text="Готово"/>

</VBox>