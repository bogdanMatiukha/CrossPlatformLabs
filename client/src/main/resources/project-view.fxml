<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.controller.MainController"
      stylesheets="@styles.css"
      styleClass="root-container">

    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <Label text="Система видачі та повернення университетського майна"
           styleClass="title-label"/>

    <TabPane fx:id="mainTabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">

        <!-- Заявки -->
        <Tab fx:id="requestTab" text="Заявки на видачу">
            <TableView fx:id="requestTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="reqIdCol" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="reqUserCol" text="ID Користувача" prefWidth="110"/>
                    <TableColumn fx:id="reqPropCol" text="ID Майна" prefWidth="90"/>
                    <TableColumn fx:id="reqStatusCol" text="Статус (ЛЦ)" prefWidth="140"/>
                    <TableColumn fx:id="reqIndexCol" text="Інтегр. індекс" prefWidth="110"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </Tab>

        <!-- Користувачі -->
        <Tab fx:id="userTab" text="Користувачі">
            <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="userIdCol" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="userFullNameCol" text="ПІБ Користувача" prefWidth="250"/>
                    <TableColumn fx:id="userRoleCol" text="Роль" prefWidth="150"/>
                    <TableColumn fx:id="userEmailCol" text="Email" prefWidth="200"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </Tab>

        <!-- Майно -->
        <Tab fx:id="propertyTab" text="Інвентар майна">
            <TableView fx:id="propertyTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="propIdCol" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="propInvCol" text="Інв. номер" prefWidth="130"/>
                    <TableColumn fx:id="propNameCol" text="Назва" prefWidth="200"/>
                    <TableColumn fx:id="propCatCol" text="Категорія" prefWidth="150"/>
                    <TableColumn fx:id="propStatusCol" text="Статус майна" prefWidth="130"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </Tab>

        <!-- Передачі -->
        <Tab fx:id="transferTab" text="Журнал передач">
            <TableView fx:id="transferTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="transIdCol" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="transReqCol" text="ID Заявки" prefWidth="90"/>
                    <TableColumn fx:id="transDateCol" text="Дата передачі" prefWidth="130"/>
                    <TableColumn fx:id="transReturnCol" text="Дата повернення" prefWidth="130"/>
                    <TableColumn fx:id="transNotesCol" text="Примітки" prefWidth="220"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </Tab>

    </TabPane>

    <Label text="Керування записами"
           styleClass="section-label"/>

    <!-- Динамічні панелі для введення даних -->
    <VBox fx:id="formContainer" spacing="8" styleClass="form-box">
        <!-- Форма для Користувачів -->
        <HBox fx:id="userFormBox" spacing="8">
            <TextField fx:id="userFullNameField" promptText="ПІБ Користувача" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="userRoleField" promptText="Роль (наприклад, Студент)" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="userEmailField" promptText="Email" HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Форма для Майна -->
        <HBox fx:id="propertyFormBox" spacing="8" managed="false" visible="false">
            <TextField fx:id="propInvField" promptText="Інвентарний номер" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="propNameField" promptText="Назва майна" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="propCatField" promptText="Категорія" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="propStatusCombo" promptText="Виберіть статус майна" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>

        <!-- Форма для Заявок -->
        <VBox fx:id="requestFormBox" spacing="8" managed="false" visible="false">
            <HBox spacing="8">
                <TextField fx:id="reqUserIdField" promptText="ID Користувача" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="reqPropIdField" promptText="ID Майна" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="reqStatusCombo" promptText="Статус заявки" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <HBox spacing="8">
                <TextField fx:id="reqF1Field" promptText="F1 (Терміновість)" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="reqF2Field" promptText="F2 (Критичність)" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="reqF3Field" promptText="F3 (Дефіцит)" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <!-- Форма для Передач -->
        <HBox fx:id="transferFormBox" spacing="8" managed="false" visible="false">
            <TextField fx:id="transReqIdField" promptText="ID Заявки" HBox.hgrow="ALWAYS"/>
            <DatePicker fx:id="transDatePicker" promptText="Дата передачі" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <DatePicker fx:id="transReturnDatePicker" promptText="Дата повернення" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <TextField fx:id="transNotesField" promptText="Примітки" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>

    <!-- Кнопки управління -->
    <HBox spacing="10">
        <Button text="Додати" onAction="#handleAdd" styleClass="primary-button"/>
        <Button fx:id="updateButton" text="Редагувати" onAction="#handleUpdate" styleClass="warning-button"/>
        <Button fx:id="deleteButton" text="Видалити" onAction="#handleDelete" styleClass="danger-button"/>
        <Button text="Очистити форму" onAction="#clearForm" styleClass="secondary-button"/>
        <Button text="Оновити список" onAction="#handleRefresh" styleClass="primary-button"/>
    </HBox>

    <Label fx:id="statusLabel" text="Готово" maxWidth="Infinity" styleClass="status-label"/>

</VBox>